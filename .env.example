GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
AGENT_BROWSER_MODE=portable

# Webcmd augments Playwright with site exploration and reusable workflow memory.
WEBCMD_ENABLED=true
WEBCMD_PROFILE=sitepulse
# WEBCMD_TIMEOUT_MS=45000
# WEBCMD_WORKFLOW_DIR=C:\path\to\durable\sitepulse-workflows
# WEBCMD_CONFIG_DIR=C:\path\to\durable\webcmd-config
# WEBCMD_CACHE_DIR=C:\path\to\durable\webcmd-cache
# WEBCMD_ENABLE_SERVERLESS=false

# Optional: connect a separately hosted Node browser worker for screenshots and
# rendered-page evidence. Hosted deployments otherwise use portable HTML analysis.
# AGENT_WORKER_URL=https://your-browser-worker.example.com
# AGENT_WORKER_TOKEN=replace_with_a_shared_secret
# Railway supplies PORT automatically. AGENT_WORKER_PORT is only a local fallback.
# AGENT_WORKER_PORT=8788

# Optional: override the compatible serverless Chromium package URL.
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v141.0.0/chromium-v141.0.0-pack.x64.tar
